# ============================================================
# HouseFunds - all settings
#
# Nothing is required. Each value can be given as an environment
# variable (Docker) or as a key in data/config.php (shared hosting);
# environment variables take precedence.
# ============================================================

# ── Application ──────────────────────────────────────────────
# Public address without trailing slash. Used in email links.
# If empty it is derived from each request: set it in production.
APP_URL=
APP_NAME=HouseFunds
# Language used when the browser language is not supported: it en es fr de pt nl pl
APP_DEFAULT_LANGUAGE=en
# PHP time zone name, e.g. Europe/Rome, America/New_York (default UTC)
APP_TIMEZONE=UTC
# production | development (development shows PHP errors)
APP_ENV=production

# ── Database ─────────────────────────────────────────────────
# Docker: leave DB_HOST empty to use the embedded MariaDB.
# mysql (MySQL/MariaDB) | pgsql (PostgreSQL)
DB_DRIVER=mysql
DB_HOST=
# default 3306 / 5432
DB_PORT=
DB_NAME=housefunds
DB_USER=housefunds
DB_PASS=
# PostgreSQL only
DB_SCHEMA=public

# ── Email ────────────────────────────────────────────────────
# MAIL_MAILER: smtp | mail | log
#   default: smtp when MAIL_HOST is set; otherwise mail (PHP mail(), the
#   hosting's own mail service) if the server has one, else log (Docker).
MAIL_MAILER=
MAIL_HOST=
# 587 STARTTLS, 465 SSL
MAIL_PORT=587
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# default: MAIL_USERNAME, or noreply@<host of APP_URL>
MAIL_FROM_ADDRESS=
# default: APP_NAME
MAIL_FROM_NAME=
MAIL_TIMEOUT=15

# Copy of every sent email in the mailbox "Sent" folder (IMAP over SSL)
MAIL_SENT_COPY=0
# default MAIL_HOST
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
# default MAIL_USERNAME
MAIL_IMAP_USERNAME=
# default MAIL_PASSWORD
MAIL_IMAP_PASSWORD=
# default: the folder flagged \Sent, otherwise "Sent Items"
MAIL_SENT_FOLDER=
